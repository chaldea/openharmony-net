<Project>
  <UsingTask TaskName="OpenHarmony.NET.Sdk.ResolveSdk" AssemblyFile="$(OpenHarmonyWorkloadRoot)/tools/net11.0/OpenHarmony.NET.Sdk.dll" />
  <UsingTask TaskName="OpenHarmony.NET.Sdk.GenerateEntryPoint" AssemblyFile="$(OpenHarmonyWorkloadRoot)/tools/net11.0/OpenHarmony.NET.Sdk.dll" />
  <UsingTask TaskName="OpenHarmony.NET.Sdk.WriteRunResponseFile" AssemblyFile="$(OpenHarmonyWorkloadRoot)/tools/net11.0/OpenHarmony.NET.Sdk.dll" />

  <!-- Override the legacy resolver that builds a helper inside the package cache.
       Workload installations are read-only during application builds. -->
  <Target Name="ResolveOpenHarmonySdk" DependsOnTargets="ValidateOpenHarmonyWorkload">
    <ResolveSdk SdkRoot="$(OpenHarmonySdkRoot)" CommandLineTools="$(OpenHarmonyCommandLineTools)" ApiLevel="$(OpenHarmonyApiLevel)">
      <Output TaskParameter="NativeRoot" PropertyName="OpenHarmonyNativeRoot" />
      <Output TaskParameter="ManifestPath" PropertyName="OpenHarmonySdkManifestPath" />
      <Output TaskParameter="ManifestSha256" PropertyName="OpenHarmonySdkManifestSha256" />
      <Output TaskParameter="Folder" PropertyName="OpenHarmonySdkFolder" />
      <Output TaskParameter="ResolvedApiLevel" PropertyName="_OpenHarmonyResolvedApiLevel" />
    </ResolveSdk>
    <PropertyGroup>
      <OpenHarmonySysroot>$(OpenHarmonyNativeRoot)/sysroot</OpenHarmonySysroot>
      <OpenHarmonyClang>$(OpenHarmonyNativeRoot)/llvm/bin/clang$(OpenHarmonyExecutableExtension)</OpenHarmonyClang>
      <OpenHarmonyClangXX>$(OpenHarmonyNativeRoot)/llvm/bin/clang++$(OpenHarmonyExecutableExtension)</OpenHarmonyClangXX>
      <OpenHarmonyLinker>$(OpenHarmonyNativeRoot)/llvm/bin/ld.lld$(OpenHarmonyExecutableExtension)</OpenHarmonyLinker>
    </PropertyGroup>
  </Target>

  <Target Name="ValidateOpenHarmonyWorkload" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(HostRuntimeIdentifier)' != 'win-x64' and '$(HostRuntimeIdentifier)' != 'linux-x64' and '$(HostRuntimeIdentifier)' != 'osx-x64' and '$(HostRuntimeIdentifier)' != 'osx-arm64'" Text="The OpenHarmony NativeAOT workload supports Windows x64, Linux x64 and macOS x64/arm64 hosts." />
    <Error Condition="'$(OpenHarmonyAbi)' != 'x86_64' and '$(OpenHarmonyAbi)' != 'arm64-v8a'" Text="OpenHarmonyAbi must be x86_64 or arm64-v8a." />
    <Error Condition="('$(OpenHarmonyAbi)' == 'x86_64' and '$(RuntimeIdentifier)' != 'linux-musl-x64') or ('$(OpenHarmonyAbi)' == 'arm64-v8a' and '$(RuntimeIdentifier)' != 'linux-musl-arm64')" Text="RuntimeIdentifier and OpenHarmonyAbi must describe the same architecture." />
    <Error Condition="!Exists('$(IlcSdkPath)System.Private.CoreLib.dll') or !Exists('$(OpenHarmonyRuntimePackPath)/../manifest.json')" Text="OpenHarmony runtime pack is missing. Run dotnet workload repair with the local package source." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(AssemblyName)', '^[A-Za-z_][A-Za-z0-9_.-]*$'))" Text="OpenHarmony AssemblyName must contain only letters, numbers, underscores, dots and hyphens." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(OpenHarmonyBundleName)', '^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)+$'))" Text="OpenHarmonyBundleName must be a dotted application identifier." />
  </Target>

  <Target Name="PrepareOpenHarmonyApplication" BeforeTargets="CoreCompile"
          DependsOnTargets="ValidateOpenHarmonyResolvedSdk;GenerateOpenHarmonyApplicationEntryPoint" />

  <Target Name="GenerateOpenHarmonyApplicationEntryPoint" Condition="'$(OpenHarmonySurface)' != 'true'">
    <PropertyGroup>
      <_OpenHarmonyGeneratedEntry>$(IntermediateOutputPath)OpenHarmonyEntryPoint.g.cs</_OpenHarmonyGeneratedEntry>
    </PropertyGroup>
    <GenerateEntryPoint FilePath="$(_OpenHarmonyGeneratedEntry)" EntryPoint="$(OpenHarmonyEntryPoint)" />
    <ItemGroup>
      <Compile Include="$(_OpenHarmonyGeneratedEntry)" />
      <FileWrites Include="$(_OpenHarmonyGeneratedEntry)" />
    </ItemGroup>
  </Target>

  <Target Name="_CopyOpenHarmonyHapLibraries" DependsOnTargets="ValidateOpenHarmonyResolvedSdk">
    <ItemGroup>
      <_OpenHarmonyNativeLibrary Include="$(OpenHarmonyRuntimePackPath)/native/*.so;$(OpenHarmonyRuntimePackPath)/native/*.so.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_OpenHarmonyNativeLibrary)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="BuildOpenHarmonyHap" AfterTargets="Publish" DependsOnTargets="_CopyOpenHarmonyHapLibraries;_PackageOpenHarmonyHap" />

  <!-- NativeAOT tasks run in the selected SDK's MSBuild process. A response file
       preserves the CLI's global properties across dotnet run's process boundary. -->
  <Target Name="PrepareOpenHarmonyRun" BeforeTargets="ComputeRunArguments">
    <PropertyGroup>
      <_OpenHarmonyRunResponse>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'harmonyos/run.rsp'))</_OpenHarmonyRunResponse>
      <RunCommand>$([MSBuild]::NormalizePath('$(MSBuildBinPath)/../../dotnet$(OpenHarmonyExecutableExtension)'))</RunCommand>
      <RunArguments>msbuild &quot;$(MSBuildProjectFullPath)&quot; -target:OpenHarmonyRun -nologo @&quot;$(_OpenHarmonyRunResponse)&quot;</RunArguments>
      <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
    </PropertyGroup>
    <WriteRunResponseFile FilePath="$(_OpenHarmonyRunResponse)" Configuration="$(Configuration)" TargetFramework="$(TargetFramework)" />
  </Target>
  <Target Name="OpenHarmonyRun" DependsOnTargets="Publish;RunOpenHarmonySurface" />
</Project>
