<Project>
  <!-- Imported by WorkloadManifest.targets after target framework inference,
       before runtime identifier inference and NativeAOT package resolution. -->
  <PropertyGroup>
    <OpenHarmonyWorkloadRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</OpenHarmonyWorkloadRoot>
    <OpenHarmonyWorkloadVersion>$([System.IO.Path]::GetFileName('$(OpenHarmonyWorkloadRoot)'))</OpenHarmonyWorkloadVersion>
    <_OpenHarmonyPacksRoot>$([System.IO.Path]::GetFullPath('$(OpenHarmonyWorkloadRoot)/../..'))</_OpenHarmonyPacksRoot>
    <TargetPlatformSupported>true</TargetPlatformSupported>
    <TargetPlatformVersion Condition="'$(TargetPlatformVersion)' == '' or '$(TargetPlatformVersion)' == '0.0'">15.0</TargetPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(SupportedOSPlatformVersion)' == ''">15.0</SupportedOSPlatformVersion>
    <OpenHarmonyTarget>true</OpenHarmonyTarget>
    <OpenHarmonyAbi Condition="'$(OpenHarmonyAbi)' == '' and '$(RuntimeIdentifier)' == 'linux-musl-arm64'">arm64-v8a</OpenHarmonyAbi>
    <OpenHarmonyAbi Condition="'$(OpenHarmonyAbi)' == ''">x86_64</OpenHarmonyAbi>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(OpenHarmonyAbi)' == 'x86_64'">linux-musl-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(OpenHarmonyAbi)' == 'arm64-v8a'">linux-musl-arm64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <SelfContained>true</SelfContained>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization Condition="'$(InvariantGlobalization)' == ''">true</InvariantGlobalization>
    <OpenHarmonyEntryPoint Condition="'$(OpenHarmonyEntryPoint)' == ''">App.Run</OpenHarmonyEntryPoint>
    <OpenHarmonyBundleName Condition="'$(OpenHarmonyBundleName)' == ''">org.openharmony.dotnet.app$([System.Text.RegularExpressions.Regex]::Replace('$(MSBuildProjectName.ToLowerInvariant())', '[^a-z0-9_]', ''))</OpenHarmonyBundleName>
    <OpenHarmonyCommandLineTools Condition="'$(OpenHarmonyCommandLineTools)' == ''">$(OHOS_COMMAND_LINE_TOOLS)</OpenHarmonyCommandLineTools>
    <OpenHarmonyJavaHome Condition="'$(OpenHarmonyJavaHome)' == ''">$(JAVA_HOME)</OpenHarmonyJavaHome>
    <OpenHarmonySdkRoot Condition="'$(OpenHarmonySdkRoot)' == ''">$(OHOS_SDK_ROOT)</OpenHarmonySdkRoot>
    <!-- Zero means infer from the single installed SDK's manifest. -->
    <OpenHarmonyApiLevel Condition="'$(OpenHarmonyApiLevel)' == ''">0</OpenHarmonyApiLevel>
    <OpenHarmonyPowerShell Condition="'$(OpenHarmonyPowerShell)' == '' and '$(OS)' == 'Windows_NT'">powershell.exe</OpenHarmonyPowerShell>
    <OpenHarmonyPowerShell Condition="'$(OpenHarmonyPowerShell)' == ''">pwsh</OpenHarmonyPowerShell>
    <OpenHarmonyUseDevelopmentSigning Condition="'$(OpenHarmonyUseDevelopmentSigning)' == '' and '$(Configuration)' == 'Debug'">true</OpenHarmonyUseDevelopmentSigning>
    <OpenHarmonyRuntimePackPath>$(_OpenHarmonyPacksRoot)/Chaldea.OpenHarmony.Runtime.NativeAot.$(OpenHarmonyAbi)/$(OpenHarmonyWorkloadVersion)/runtime-pack</OpenHarmonyRuntimePackPath>
    <IlcFrameworkNativePath>$(OpenHarmonyRuntimePackPath)/native/</IlcFrameworkNativePath>
    <IlcSdkPath>$(OpenHarmonyRuntimePackPath)/sdk/</IlcSdkPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Chaldea.OpenHarmony.Framework" Version="$(OpenHarmonyWorkloadVersion)" IsImplicitlyDefined="true" />
    <SupportedPlatform Include="ohos" />
    <SdkSupportedTargetPlatformVersion Include="15.0" />
  </ItemGroup>
  <Import Project="../targets/Crosscompile.targets" />
  <Import Project="../targets/OpenHarmony.NET.Sdk.targets" />
</Project>
