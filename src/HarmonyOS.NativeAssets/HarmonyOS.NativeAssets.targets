<Project>
  <PropertyGroup>
    <HarmonyGraphicsTargetsImported>true</HarmonyGraphicsTargetsImported>
  </PropertyGroup>
  <Target Name="SelectHarmonyGraphicsAssets" BeforeTargets="AssignTargetPaths"
          Condition="'$(OpenHarmonyTarget)' == 'true' or '$(TargetPlatformIdentifier)' == 'ohos'">
    <PropertyGroup>
      <_HarmonyGraphicsAbi>$(OpenHarmonyAbi)</_HarmonyGraphicsAbi>
      <_HarmonyGraphicsAbi Condition="'$(_HarmonyGraphicsAbi)' == '' and '$(RuntimeIdentifier)' == 'linux-musl-x64'">x86_64</_HarmonyGraphicsAbi>
      <_HarmonyGraphicsAbi Condition="'$(_HarmonyGraphicsAbi)' == '' and '$(RuntimeIdentifier)' == 'linux-musl-arm64'">arm64-v8a</_HarmonyGraphicsAbi>
    </PropertyGroup>
    <Error Condition="'$(_HarmonyGraphicsAbi)' != 'x86_64' and '$(_HarmonyGraphicsAbi)' != 'arm64-v8a'"
           Text="HarmonyOS graphics native assets require OpenHarmonyAbi=x86_64 or arm64-v8a." />
    <Error Condition="('$(RuntimeIdentifier)' != '' and '$(_HarmonyGraphicsAbi)' == 'x86_64' and '$(RuntimeIdentifier)' != 'linux-musl-x64') or ('$(RuntimeIdentifier)' != '' and '$(_HarmonyGraphicsAbi)' == 'arm64-v8a' and '$(RuntimeIdentifier)' != 'linux-musl-arm64')"
           Text="HarmonyOS graphics RuntimeIdentifier and OpenHarmonyAbi must match." />
    <Error Condition="!Exists('%(_HarmonyGraphicsAsset.Root)/$(_HarmonyGraphicsAbi)/%(_HarmonyGraphicsAsset.Identity)')"
           Text="Missing HarmonyOS native asset: %(_HarmonyGraphicsAsset.Identity) for $(_HarmonyGraphicsAbi)." />
    <ItemGroup>
      <Content Include="@(_HarmonyGraphicsAsset->'%(Root)/$(_HarmonyGraphicsAbi)/%(Identity)')">
        <Link>%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>
</Project>
