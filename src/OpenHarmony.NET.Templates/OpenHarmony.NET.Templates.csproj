<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Chaldea.OpenHarmony.Templates</PackageId>
    <PackageType>Template</PackageType>
    <Authors>OpenHarmony.NET</Authors>
    <Description>dotnet new ohos application template.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../OpenHarmony.NET.Sdk/README.md" Pack="true" PackagePath="/" />
    <None Include="content/**" Pack="true" PackagePath="%(Identity)" Exclude="content/**/bin/**;content/**/obj/**" />
  </ItemGroup>
</Project>
