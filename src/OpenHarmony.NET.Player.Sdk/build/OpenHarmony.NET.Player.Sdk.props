<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<!--
		OpenHarmony.NET.Player.Sdk props
		================================
		Imported automatically by NuGet when the consuming project references this
		package (build/OpenHarmony.NET.Player.Sdk.props runs during the top props
		pass, before targets evaluation).

		Goals here (gated on OpenHarmonyTarget):
		  1. Derive OpenHarmonyAbi from RuntimeIdentifier as early as possible, so
		     every downstream target (Crosscompile.targets, the per-ABI runtime
		     pack buildTransitive targets, and our own Player.Sdk.targets) sees a
		     consistent ABI.
		  2. Set the sane defaults the Blazor.Hybrid Entry.csproj pattern relied
		     on, but ONLY when the consumer has not already set them. The
		     XEngine-generated csproj already sets most of these; the Condition
		     guards keep us idempotent.

		We deliberately do NOT:
		  - import Crosscompile.targets or runtime.targets by file path. Those are
		    now pulled in transitively by the NuGet dependencies declared in the
		    nuproj (OpenHarmony.NET.PublishAotCross -> build/*.targets, and the two
		    OpenHarmony.NET.Runtime.NativeAot.<abi> packs -> buildTransitive).
		  - override IlcFrameworkNativePath / IlcSdkPath here. That is done in the
		    targets file, after NuGet has imported both ABI runtime packs.
	-->

	<PropertyGroup Condition="'$(OpenHarmonyTarget)' == 'true'">

		<!-- Derive the ABI from the RID so it is set before any per-ABI target
		     evaluates. RuntimeIdentifier may be set in the csproj or via -p: at
		     restore/eval time. -->
		<OpenHarmonyAbi Condition="'$(OpenHarmonyAbi)' == '' and $(RuntimeIdentifier.EndsWith('-arm64'))">arm64-v8a</OpenHarmonyAbi>
		<OpenHarmonyAbi Condition="'$(OpenHarmonyAbi)' == '' and $(RuntimeIdentifier.EndsWith('-x64'))">x86_64</OpenHarmonyAbi>

		<!-- Sane defaults matching the Entry.csproj pattern. Never override an
		     explicit consumer value. -->
		<PublishAot Condition="'$(PublishAot)' == ''">true</PublishAot>
		<NativeLib Condition="'$(NativeLib)' == ''">Shared</NativeLib>
		<SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>

		<!-- API level default; consumers almost always pass -p:OpenHarmonyApiLevel. -->
		<OpenHarmonyApiLevel Condition="'$(OpenHarmonyApiLevel)' == ''">15</OpenHarmonyApiLevel>

		<!-- OpenHarmonySdkRoot falls back to the OHOS_SDK_ROOT env var so a build
		     works without -p:OpenHarmonySdkRoot when the env is configured. -->
		<OpenHarmonySdkRoot Condition="'$(OpenHarmonySdkRoot)' == ''">$(OHOS_SDK_ROOT)</OpenHarmonySdkRoot>

	</PropertyGroup>

</Project>
