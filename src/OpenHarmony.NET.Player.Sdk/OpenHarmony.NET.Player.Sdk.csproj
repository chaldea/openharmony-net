<Project Sdk="Microsoft.Build.NoTargets">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Chaldea.OpenHarmony.Player.Sdk</PackageId>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Package dependencies are consumed after packing; source builds do not
         require prebuilt runtime packages. -->
    <NuspecFile>OpenHarmony.NET.Player.Sdk.nuspec</NuspecFile>
    <NuspecProperties>version=$(Version)</NuspecProperties>
    <NuspecBasePath>$(MSBuildProjectDirectory)</NuspecBasePath>
  </PropertyGroup>
</Project>
