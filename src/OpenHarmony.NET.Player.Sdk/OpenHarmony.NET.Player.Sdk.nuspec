      <dependency id="Chaldea.OpenHarmony.Runtime.NativeAot.x86_64" version="[$version$]" />
    </dependencies>
  </metadata>
  <files>
    <file src="build\OpenHarmony.NET.Player.Sdk.props" target="build\Chaldea.OpenHarmony.Player.Sdk.props" />
