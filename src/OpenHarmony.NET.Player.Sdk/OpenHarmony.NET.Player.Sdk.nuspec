<?xml version="1.0"?>
<package>
  <metadata>
    <id>OpenHarmony.NET.Player.Sdk</id>
    <version>$version$</version>
    <authors>OpenHarmony.NET</authors>
    <description>MSBuild SDK for OpenHarmony NativeAOT shared libraries.</description>
    <license type="expression">MIT</license>
    <readme>README.md</readme>
    <dependencies>
      <dependency id="OpenHarmony.NET.PublishAotCross" version="[$version$]" />
      <dependency id="OpenHarmony.NET.Runtime.NativeAot.arm64-v8a" version="[$version$]" />
      <dependency id="OpenHarmony.NET.Runtime.NativeAot.x86_64" version="[$version$]" />
    </dependencies>
  </metadata>
  <files>
    <file src="build\*" target="build" />
    <file src="README.md" target="" />
  </files>
</package>
