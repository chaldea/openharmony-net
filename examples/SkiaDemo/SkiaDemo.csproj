<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>openharmony_skia</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="HarfBuzzSharp" Version="7.3.0.3" />
  </ItemGroup>
  <PropertyGroup Condition="'$(OpenHarmonyTarget)' == 'true'">
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <SelfContained>true</SelfContained>
    <OpenHarmonyAbi Condition="'$(OpenHarmonyAbi)' == ''">x86_64</OpenHarmonyAbi>
    <RuntimeIdentifier Condition="'$(OpenHarmonyAbi)' == 'x86_64'">linux-musl-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(OpenHarmonyAbi)' == 'arm64-v8a'">linux-musl-arm64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup Condition="'$(OpenHarmonyTarget)' == 'true'">
    <PackageReference Include="Chaldea.OpenHarmony.Player.Sdk" Version="$(OpenHarmonyPackageVersion)" />
    <PackageReference Include="Chaldea.SkiaSharp.NativeAssets.HarmonyOS" Version="$(OpenHarmonyPackageVersion)" />
    <PackageReference Include="Chaldea.HarfBuzzSharp.NativeAssets.HarmonyOS" Version="$(OpenHarmonyPackageVersion)" />
  </ItemGroup>
</Project>
