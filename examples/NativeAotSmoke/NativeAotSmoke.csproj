<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>openharmony_smoke</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OpenHarmonyTarget)' == 'true'">
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <SelfContained>true</SelfContained>
    <OpenHarmonyAbi Condition="'$(OpenHarmonyAbi)' == ''">x86_64</OpenHarmonyAbi>
    <RuntimeIdentifier Condition="'$(OpenHarmonyAbi)' == 'x86_64'">linux-musl-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(OpenHarmonyAbi)' == 'arm64-v8a'">linux-musl-arm64</RuntimeIdentifier>
  </PropertyGroup>
  <Import Project="../../src/PublishAotCross/package/OpenHarmony.NET.PublishAotCross.targets" />
  <Import Project="../../src/OpenHarmony.NET.Runtime/runtime.targets" Condition="'$(OpenHarmonyTarget)' == 'true'" />
</Project>
