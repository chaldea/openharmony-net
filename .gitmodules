[submodule "ClangSharp"]
	path = dotnet/ClangSharp
	url = https://github.com/dotnet/ClangSharp.git
[submodule "core-origin"]
	path = dotnet/core-origin
	url = https://github.com/dotnet/core.git
[submodule "runtime"]
	path = dotnet/runtime
	url = https://github.com/chaldea/openharmony-net-runtime.git
[submodule "runtime-origin"]
	path = dotnet/runtime-origin
	url = https://github.com/dotnet/runtime.git
[submodule "dotnet/SkiaSharp"]
	path = dotnet/SkiaSharp
	url = https://github.com/mono/SkiaSharp.git
